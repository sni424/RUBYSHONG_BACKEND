generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 관리자 계정 권한
// owner: 전체 권한, 예약/상품 삭제 가능
// manager: 예약 변경 가능, 삭제 불가
// staff: 예약 변경 가능, 삭제 불가
enum UserRole {
  owner
  manager
  staff
}

// 예약 상태
// pending: 대기
// completed: 완료
// cancelled: 취소
enum ReservationStatus {
  pending
  completed
  cancelled
}

// 예약 변경 이력 종류
// created: 생성
// updated: 예약 정보 수정
// status_changed: 상태만 변경
enum ReservationAction {
  created
  updated
  status_changed
}

model Product {
  id            Int      @id @default(autoincrement())

  name          String
  slug          String   @unique

  category      String

  // 원가
  price         Int

  // 최종 판매 가격
  finalPrice    Int

  // 할인율 (%)
  discountRate  Int      @default(0)

  // 짧은 설명
  summary       String

  // 상세 설명
  description   String

  // Azure Blob 이미지 URL
  thumbnailUrl  String

  isNew         Boolean  @default(false)
  isBest        Boolean  @default(false)
  isVisible     Boolean  @default(true)

  stock         Int      @default(0)

  // 상품 상태: selling, soldout, hidden
  status        String   @default("selling")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AdminUser {
  id        Int      @id @default(autoincrement())

  // 관리자 로그인 이메일
  email     String   @unique

  // 암호화된 비밀번호
  password  String

  // 계정 권한: owner, manager, staff
  role      UserRole @default(staff)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 이 관리자가 변경한 예약 이력 목록
  reservationHistories ReservationHistory[]

  // 이 관리자가 삭제한 예약 기록 목록
  reservationDeleteLogs ReservationDeleteLog[]

  // 이 관리자가 삭제한 상품 기록 목록
  productDeleteLogs ProductDeleteLog[]

  // 이 관리자가 삭제한 문의 기록 목록
  contactInquiryDeleteLogs ContactInquiryDeleteLog[]
}

model ProductDeleteLog {
  id Int @id @default(autoincrement())

  // 삭제된 상품 ID
  // Product는 실제 삭제되므로 relation을 걸지 않고 숫자만 보관
  productId Int

  // 삭제 당시 상품명
  productName String

  // 삭제 당시 상품 slug
  productSlug String

  // 삭제한 관리자 ID
  deletedById Int

  // 삭제한 관리자
  deletedBy AdminUser @relation(fields: [deletedById], references: [id])

  // 삭제 당시 상품 전체 데이터
  deletedData Json

  // 삭제된 시간
  createdAt DateTime @default(now())
}

model Reservation {
  id        Int      @id @default(autoincrement())

  // 고객 정보
  name      String
  phone     String

  // 방문 날짜: YYYY-MM-DD
  visitDate String

  // 방문 시간: HH:mm
  visitTime String

  // 상담 내용
  message   String?

  // 예약 상태: pending, completed, cancelled
  status    ReservationStatus @default(pending)

  // 개인정보 동의 여부
  privacyAgreed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 이 예약의 변경 이력 목록
  // 예약이 삭제되면 이력도 같이 삭제됨
  histories ReservationHistory[]

  // 같은 날짜와 같은 시간에는 하나의 예약만 허용
  @@unique([visitDate, visitTime])
}

model ReservationHistory {
  id Int @id @default(autoincrement())

  // 변경된 예약 ID
  reservationId Int

  // 변경된 예약
  // 예약이 실제 삭제되면 변경 이력도 같이 삭제
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  // 변경 종류: created, updated, status_changed
  action ReservationAction

  // 변경한 관리자 ID
  changedById Int

  // 변경한 관리자
  changedBy AdminUser @relation(fields: [changedById], references: [id])

  // 변경 전 데이터
  // 예: 수정 전 name, phone, visitDate, status 등
  beforeData Json?

  // 변경 후 데이터
  // 예: 수정 후 name, phone, visitDate, status 등
  afterData Json?

  // 변경이 발생한 시간
  createdAt DateTime @default(now())
}

model ReservationDeleteLog {
  id Int @id @default(autoincrement())

  // 삭제된 예약 ID
  // Reservation은 실제 삭제되므로 relation을 걸지 않고 숫자만 보관
  reservationId Int

  // 삭제 당시 방문 날짜: YYYY-MM-DD
  visitDate String

  // 삭제 당시 방문 시간: HH:mm
  visitTime String

  // 삭제 당시 예약 상태
  status ReservationStatus

  // 삭제한 관리자 ID
  deletedById Int

  // 삭제한 관리자
  deletedBy AdminUser @relation(fields: [deletedById], references: [id])

  // 삭제 당시 예약 전체 데이터
  // 나중에 어떤 예약이 삭제됐는지 확인용
  deletedData Json

  // 삭제된 시간
  createdAt DateTime @default(now())
}

model ContactInquiry {
  id        Int      @id @default(autoincrement())

  // 고객 정보
  name      String
  phone     String

  // 문의 제목
  title     String

  // 문의 내용
  message   String

  // 문의 상태: pending, answered, closed
  status    String   @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactInquiryDeleteLog {
  id Int @id @default(autoincrement())

  // 삭제된 문의 ID
  contactInquiryId Int

  // 삭제 당시 문의 제목
  title String

  // 삭제 당시 고객명
  name String

  // 삭제 당시 연락처
  phone String

  // 삭제 당시 문의 전체 데이터
  deletedData Json

  // 삭제한 관리자 ID
  deletedById Int

  // 삭제한 관리자
  deletedBy AdminUser @relation(fields: [deletedById], references: [id])

  // 삭제된 시간
  createdAt DateTime @default(now())
}