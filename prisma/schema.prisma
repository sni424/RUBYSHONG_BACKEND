generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id            Int      @id @default(autoincrement())

  name          String
  slug          String   @unique

  category      String

  // 원가
  price         Int

  // 최종 판매 가격
  finalPrice    Int

  // 할인율 (%)
  discountRate  Int      @default(0)

  // 짧은 설명
  summary       String

  // 상세 설명
  description   String

  // Azure Blob 이미지 URL
  thumbnailUrl  String

  isNew         Boolean  @default(false)
  isBest        Boolean  @default(false)
  isVisible     Boolean  @default(true)

  stock         Int      @default(0)

  // 상품 상태: selling, soldout, hidden
  status        String   @default("selling")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}