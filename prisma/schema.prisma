generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id            Int      @id @default(autoincrement())

  name          String
  slug          String   @unique

  category      String

  // 원가
  price         Int

  // 최종 판매 가격
  finalPrice    Int

  // 할인율 (%)
  discountRate  Int      @default(0)

  // 짧은 설명
  summary       String

  // 상세 설명
  description   String

  // Azure Blob 이미지 URL
  thumbnailUrl  String

  isNew         Boolean  @default(false)
  isBest        Boolean  @default(false)
  isVisible     Boolean  @default(true)

  stock         Int      @default(0)

  // 상품 상태: selling, soldout, hidden
  status        String   @default("selling")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reservation {
  id        Int      @id @default(autoincrement())

  // 고객 정보
  name      String
  phone     String

  // 방문 날짜: YYYY-MM-DD
  visitDate String

  // 방문 시간: HH:mm
  visitTime String

  // 상담 내용
  message   String?

  // 예약 상태: pending, confirmed, cancelled, completed
  status    String   @default("pending")

  // 개인정보 동의 여부
  privacyAgreed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 같은 날짜와 같은 시간에는 하나의 예약만 허용
  @@unique([visitDate, visitTime])
}