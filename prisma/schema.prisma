generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 관리자 계정 권한
// owner: 전체 권한, 예약/상품 삭제 가능
// manager: 예약 변경 가능, 삭제 불가
// staff: 예약 변경 가능, 삭제 불가
enum UserRole {
  owner
  manager
  staff
}

// 예약 상태
// pending: 대기
// completed: 완료
// cancelled: 취소
enum ReservationStatus {
  pending
  completed
  cancelled
}

// 예약 변경 이력 종류
// created: 생성
// updated: 예약 정보 수정
// status_changed: 상태만 변경
enum ReservationAction {
  created
  updated
  status_changed
}

model Product {
  id            Int      @id @default(autoincrement())

  name          String
  slug          String   @unique

  category      String

  // 원가
  price         Int

  // 최종 판매 가격
  finalPrice    Int

  // 할인율 (%)
  discountRate  Int      @default(0)

  // 짧은 설명
  summary       String

  // 상세 설명
  description   String

  // Azure Blob 이미지 URL
  thumbnailUrl  String

  isNew         Boolean  @default(false)
  isBest        Boolean  @default(false)
  isVisible     Boolean  @default(true)

  stock         Int      @default(0)

  // 상품 상태: selling, soldout, hidden
  status        String   @default("selling")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 이 상품이 포함된 주문 상품 목록
  orderItems OrderItem[]
}

model AdminUser {
  id        Int      @id @default(autoincrement())

  // 관리자 로그인 이메일
  email     String   @unique

  // 암호화된 비밀번호
  password  String

  // 계정 권한: owner, manager, staff
  role      UserRole @default(staff)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 이 관리자가 변경한 예약 이력 목록
  reservationHistories ReservationHistory[]

  // 이 관리자가 삭제한 예약 기록 목록
  reservationDeleteLogs ReservationDeleteLog[]

  // 이 관리자가 삭제한 상품 기록 목록
  productDeleteLogs ProductDeleteLog[]

  // 이 관리자가 삭제한 문의 기록 목록
  contactInquiryDeleteLogs ContactInquiryDeleteLog[]

  // 이 관리자가 처리한 주문 이력 목록
  orderHistories OrderHistory[]
}

model ProductDeleteLog {
  id Int @id @default(autoincrement())

  // 삭제된 상품 ID
  // Product는 실제 삭제되므로 relation을 걸지 않고 숫자만 보관
  productId Int

  // 삭제 당시 상품명
  productName String

  // 삭제 당시 상품 slug
  productSlug String

  // 삭제한 관리자 ID
  deletedById Int

  // 삭제한 관리자
  deletedBy AdminUser @relation(fields: [deletedById], references: [id])

  // 삭제 당시 상품 전체 데이터
  deletedData Json

  // 삭제된 시간
  createdAt DateTime @default(now())
}

model Reservation {
  id        Int      @id @default(autoincrement())

  // 고객 정보
  name      String
  phone     String

  // 방문 날짜: YYYY-MM-DD
  visitDate String

  // 방문 시간: HH:mm
  visitTime String

  // 상담 내용
  message   String?

  // 예약 상태: pending, completed, cancelled
  status    ReservationStatus @default(pending)

  // 개인정보 동의 여부
  privacyAgreed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 이 예약의 변경 이력 목록
  // 예약이 삭제되면 이력도 같이 삭제됨
  histories ReservationHistory[]

  // 같은 날짜와 같은 시간에는 하나의 예약만 허용
  @@unique([visitDate, visitTime])
}

model ReservationHistory {
  id Int @id @default(autoincrement())

  // 변경된 예약 ID
  reservationId Int

  // 변경된 예약
  // 예약이 실제 삭제되면 변경 이력도 같이 삭제
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  // 변경 종류: created, updated, status_changed
  action ReservationAction

  // 변경한 관리자 ID
  changedById Int

  // 변경한 관리자
  changedBy AdminUser @relation(fields: [changedById], references: [id])

  // 변경 전 데이터
  // 예: 수정 전 name, phone, visitDate, status 등
  beforeData Json?

  // 변경 후 데이터
  // 예: 수정 후 name, phone, visitDate, status 등
  afterData Json?

  // 변경이 발생한 시간
  createdAt DateTime @default(now())
}

model ReservationDeleteLog {
  id Int @id @default(autoincrement())

  // 삭제된 예약 ID
  // Reservation은 실제 삭제되므로 relation을 걸지 않고 숫자만 보관
  reservationId Int

  // 삭제 당시 방문 날짜: YYYY-MM-DD
  visitDate String

  // 삭제 당시 방문 시간: HH:mm
  visitTime String

  // 삭제 당시 예약 상태
  status ReservationStatus

  // 삭제한 관리자 ID
  deletedById Int

  // 삭제한 관리자
  deletedBy AdminUser @relation(fields: [deletedById], references: [id])

  // 삭제 당시 예약 전체 데이터
  // 나중에 어떤 예약이 삭제됐는지 확인용
  deletedData Json

  // 삭제된 시간
  createdAt DateTime @default(now())
}

model ContactInquiry {
  id        Int      @id @default(autoincrement())

  // 고객 정보
  name      String
  phone     String

  // 문의 제목
  title     String

  // 문의 내용
  message   String

  // 문의 상태: pending, answered, closed
  status    String   @default("pending")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactInquiryDeleteLog {
  id Int @id @default(autoincrement())

  // 삭제된 문의 ID
  contactInquiryId Int

  // 삭제 당시 문의 제목
  title String

  // 삭제 당시 고객명
  name String

  // 삭제 당시 연락처
  phone String

  // 삭제 당시 문의 전체 데이터
  deletedData Json

  // 삭제한 관리자 ID
  deletedById Int

  // 삭제한 관리자
  deletedBy AdminUser @relation(fields: [deletedById], references: [id])

  // 삭제된 시간
  createdAt DateTime @default(now())
}

enum SocialProvider {
  naver
  kakao
}

model User {
  id        Int      @id @default(autoincrement())

  // 로그인 이메일
  email     String   @unique

  // 암호화된 비밀번호
  // SNS 회원은 비밀번호 없이 가입될 수 있음
  password  String?

  // 회원 이름
  name      String

  // 연락처
  phone     String?

  // 휴대폰 인증 여부
  phoneVerified Boolean @default(false)

  // SNS 로그인 제공자: naver, kakao
  provider SocialProvider?

  // SNS 제공자가 주는 고유 ID
  providerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, providerId])
  // 이 회원의 주문 목록
  orders Order[]
}

model PhoneVerification {
  id        Int      @id @default(autoincrement())

  // 인증할 휴대폰 번호
  phone     String

  // 인증번호
  code      String

  // 인증 완료 여부
  verified  Boolean  @default(false)

  // 인증번호 만료 시간
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 주문 상태
// pending: 결제 진행 중
// paid: 결제 완료
// cancelled: 주문 취소
// failed: 결제 실패
// refunded: 환불 완료
enum OrderStatus {
  pending
  paid
  cancelled
  failed
  refunded
}

// 결제 상태
// ready: 결제 승인 전
// paid: 결제 승인 완료
// failed: 결제 실패
// cancelled: 결제 취소
// refunded: 환불 완료
enum PaymentStatus {
  ready
  paid
  failed
  cancelled
  refunded
}

model Order {
  id Int @id @default(autoincrement())

  // 주문번호
  // 토스페이먼츠 orderId로도 사용
  orderCode String @unique

  // 주문 회원 ID
  // 비회원 주문도 허용하려면 nullable 유지
  userId Int?

  // 주문 회원
  user User? @relation(fields: [userId], references: [id])

  // 주문자 이름
  ordererName String

  // 주문자 휴대폰 번호
  ordererPhone String

  // 주문 총 금액
  totalAmount Int

  // 주문 상태
  status OrderStatus @default(pending)

  // 주문 상품 목록
  items OrderItem[]

  // 결제 정보
  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 주문 변경 이력
  histories OrderHistory[]
}

model OrderItem {
  id Int @id @default(autoincrement())

  // 주문 ID
  orderId Int

  // 주문
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // 상품 ID
  productId Int

  // 상품
  product Product @relation(fields: [productId], references: [id])

  // 주문 당시 상품명
  productName String

  // 주문 당시 상품 썸네일 URL
  thumbnailUrl String

  // 주문 당시 상품 가격
  price Int

  // 주문 수량
  quantity Int @default(1)

  // 주문 상품 총 금액
  amount Int

  createdAt DateTime @default(now())
}

model Payment {
  id Int @id @default(autoincrement())

  // 주문 ID
  orderId Int @unique

  // 주문
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // 토스페이먼츠 paymentKey
  paymentKey String? @unique

  // 토스페이먼츠 orderId
  tossOrderId String @unique

  // 결제 금액
  amount Int

  // 결제 상태
  status PaymentStatus @default(ready)

  // 결제 수단
  method String?

  // 결제 승인 시간
  approvedAt DateTime?

  // 결제 실패 사유
  failureReason String?

  // 토스 원본 응답
  rawData Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderAction {
  created
  paid
  cancelled
  refunded
  status_changed
}

model OrderHistory {
  id Int @id @default(autoincrement())

  // 주문 ID
  orderId Int
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // 처리한 관리자 ID
  changedById Int?
  changedBy AdminUser? @relation(fields: [changedById], references: [id])

  // 이력 종류
  action OrderAction

  // 변경 전 데이터
  beforeData Json?

  // 변경 후 데이터
  afterData Json?

  createdAt DateTime @default(now())
}